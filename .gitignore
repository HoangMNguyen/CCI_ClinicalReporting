# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  The root-level *.spec files are hand-maintained build recipes (one per app,
#  version-independent) and ARE tracked in Git, so they are not ignored here.
#  Only generated manifests are.
*.manifest

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Environments
.env
.venv

# Local env shortcut scripts (machine-specific; README "Setup" has the commands)
/dev.sh
env/
venv/
ENV/
env.bak/
venv.bak/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# AI directional
/AGENTS.md
/.omp

# AWS SAM build/deployment files (samconfig may contain the counter token)
.aws-sam/
samconfig.toml

# Local desktop telemetry credentials (bundled into release executables)
/src/clinical_reporting/telemetry.json

# Old CCI Automation Clockify credentials (feature removed; a leftover copy
# would hold an API key, so never commit it)
/src/cci_automation/clockify.json

# Study data (exports, generated reports, extra inputs) never belongs in
# Git: tests use made-up data built in code. No data file is tracked; a
# deliberate exception needs git add -f.
/tests/data/
*.zip
*.csv
*.xls*

# Server-side infrastructure: tracked, except the live stats dashboard file
# (it holds the StatsToken) and the SAM build/config output above.
/infra/run_counter/stats_dashboard.json

# Copied AWS CLI login session (never commit)
/.aws/

# Local Claude Code files: settings, visual drafts and agent worktrees.
/.claude/
